&=  \sum_{k=0}^{50}  \binom{1000}{l}  x^k+  \sum_{k = 50}^{1000}     \sum_{l = k}^{(l + k) = 1000} \binom{1000}{l}  x^k\\
&=  \sum_{k= 50}^{1000}  \sum_{l = k}^{(l + k) = 1000}  \binom{1000}{l} x^k\\
&= \sum_{k= 50}^{1000} \left( \sum_{l= 50+ k}^{1000+ k}  \binom{1000}{l}   \right) x^k\\
&= \sum_{k= 50}^{1000} \left( \sum_{l= k}^{1000}  \binom{1000}{k + l}
\right) x^k \\
&= \sum_{k= 50}^{1000} (  \sum_{l =  0}^{ 1000- k   } { \: \; \; \binom{1000}{ k+ l }   }  ) x^k  \\
&=   \sum_{k= 0}^{1000}  \sum_{l= 0}^{1000- k }  \binom{1000}{l}   x^k \\
&=  \sum_{k= 0}
